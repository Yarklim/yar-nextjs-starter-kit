{
  "name": "yar-nextjs-with-i18n-starter-kit",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Yaroslav Klimas",
    "url": "https://github.com/Yarklim"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm clean:next-dev && next build",
    "clean:next-dev": "node -e \"require('node:fs').rmSync('.next/dev', { recursive: true, force: true })\"",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typegen": "next typegen",
    "typecheck": "pnpm clean:next-dev && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:forms": "vitest run tests/forms"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.8.1"
}
